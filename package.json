{
  "name": "token-consumption-statistics",
  "displayName": "Token Consumption Statistics",
  "description": "Track AI API calls and token usage for Copilot/Cline/Kilo",
  "version": "0.0.1",
  "publisher": "JimmyKodu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JimmyKodu/TokenConsumptionStatistics.git"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:token-consumption-statistics.openDashboard",
    "onCommand:token-consumption-statistics.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "token-consumption-statistics.openDashboard",
        "title": "Token Consumption: Open Dashboard"
      },
      {
        "command": "token-consumption-statistics.refresh",
        "title": "Token Consumption: Refresh"
      }
    ],
    "configuration": {
      "title": "Token Consumption Statistics",
      "properties": {
        "tokenConsumptionStatistics.refreshIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Auto-refresh interval in minutes (0 disables auto-refresh)."
        },
        "tokenConsumptionStatistics.scan.maxFiles": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "description": "Maximum number of files to scan per provider."
        },
        "tokenConsumptionStatistics.scan.maxFileSizeKb": {
          "type": "number",
          "default": 2048,
          "minimum": 64,
          "description": "Skip files larger than this size (KB)."
        },
        "tokenConsumptionStatistics.copilot.exportJsonPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Absolute file paths to GitHub Copilot Chat exported log JSON files."
        },
        "tokenConsumptionStatistics.custom.exportJsonPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Absolute file paths to additional exported JSON/JSONL usage logs (e.g., Codebuddy)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0"
  }
}
